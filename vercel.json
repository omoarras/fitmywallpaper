{
  "outputDirectory": "public",
  "functions": {
    "api/convert.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "fit-my-wallpaper.vercel.app"
        }
      ],
      "destination": "https://www.pawlowallpaper.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/ads/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/pins/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}